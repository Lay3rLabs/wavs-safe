DEPLOY_ENV=LOCAL
METADATA_URI=https://raw.githubusercontent.com/Lay3rLabs/wavs-safe/refs/heads/main/metadata.json
LOCAL_ETHEREUM_RPC_URL=http://localhost:8545

CHAIN_ID=17000
TESTNET_RPC_URL=https://1rpc.io/holesky

# this key requires funds. used as the admin / deployer of contracts and core contracts.
FUNDED_KEY=

LST_CONTRACT_ADDRESS=0x3F1c547b21f65e10480dE3ad8E19fAAC46C95034
LST_STRATEGY_ADDRESS=0x7D704507b76571a51d9caE8AdDAbBFd0ba0e63d3

# https://app.pinata.cloud/developers/api-keys, JWT token
PINATA_API_KEY=
ETHERSCAN_API_KEY=foobar

## wavs-safe
# Safe configuration - uses FUNDED_KEY/deployer if not set
SAFE_OWNERS=
SAFE_THRESHOLD=1
SAFE_FALLBACK_HANDLER=0x0000000000000000000000000000000000000000
# Set to true to deploy a new Safe, false to use existing
DEPLOY_NEW_SAFE=true
# Only needed if DEPLOY_NEW_SAFE is false
EXISTING_SAFE_ADDRESS=0x0000000000000000000000000000000000000000
ENABLE_MODULE=true
